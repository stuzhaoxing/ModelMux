<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.modelmux.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/modelmux/scripts/start-local.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>UserName</key>
  <string>modelmux</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/opt/modelmux/logs/modelmux.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/modelmux/logs/modelmux-error.log</string>
</dict>
</plist>
