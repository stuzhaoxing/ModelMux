# 公网调试实例的 nginx 反向代理参考示例，安装到
# /etc/nginx/conf.d/modelmux.conf（或 sites-available 再软链）。
# 应用本身监听 127.0.0.1:4000（.env.local 里的 HOSTNAME/PORT），
# TLS 在这一层终止，模型请求不附加频率或大小限制。

server {
    listen 80;
    listen [::]:80;
    server_name debug.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name debug.example.com;

    ssl_certificate     /etc/nginx/ssl/debug.example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/debug.example.com.key;

    # 题目、答案附件和模型请求都没有应用层固定大小上限。
    # 0 表示 nginx 也不限制，实际容量由数据盘和文件系统决定。
    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # 大附件边接收边转发，避免 nginx 先把整个请求落入临时目录。
        proxy_request_buffering off;

        # 必须关缓冲：/v1/* 的流式响应和考核系统的实时通道都是 SSE，
        # 一旦被 nginx 攒着不发，选手端会先看到"离线"再看到迟到的题目。
        proxy_buffering off;
        proxy_cache off;
        gzip off;

        # 模型思考时间可能很长，读超时要大于上游最慢的一次响应
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
