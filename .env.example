# public: pre-event Internet service; local: competition Mac mini
MODELMUX_DEPLOYMENT_MODE=local
MODELMUX_PUBLIC_BASE_URL=http://localhost:1444
# Ingress addresses shown in the administrator overview.
MODELMUX_INTERNAL_BASE_URL=http://10.20.0.1:4000
# Leave blank when the service has no public inbound endpoint.
MODELMUX_EXTERNAL_BASE_URL=

# Client access. Keep anonymous access disabled outside isolated development.
# Example after generating keys: MODELMUX_CLIENT_KEYS=client-key-1,client-key-2
MODELMUX_CLIENT_KEYS=
# 每位新建选手默认可成功调用模型的总次数
MODELMUX_CONTESTANT_REQUEST_QUOTA=1000
MODELMUX_ALLOW_ANONYMOUS=false
MODELMUX_RATE_LIMIT_RPM=60
MODELMUX_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
MODELMUX_ADMIN_SESSION_SECRET=
# Enable only when a trusted reverse proxy overwrites forwarded client headers.
MODELMUX_TRUST_PROXY=false

# Competition question-and-answer system. MySQL stores users, questions,
# answers and timestamps; uploaded images remain on this server.
MODELMUX_DATABASE_URL=mysql://modelmux:change-me@127.0.0.1:3306/modelmux
MODELMUX_DATA_DIR=.modelmux-data
# 实时通道（SSE）每个在线客户端的数据库轮询间隔，毫秒。调大省数据库、事件更慢。
# 取值被限制在 500-15000 之间，留空使用默认 3000。
MODELMUX_EVENT_POLL_MS=3000

# Upstream providers. Each variable accepts a comma-separated key pool.
# DeepSeek official serves deepseek-*; Alibaba Cloud serves qwen-*;
# SiliconFlow supplies the fallback route for both model families.
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEYS=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
SILICONFLOW_API_KEYS=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# Official model IDs. The legacy MODEL_DEEPSEEK and MODEL_QWEN variables are
# still accepted as overrides for the two Pro tiers.
MODEL_DEEPSEEK_FLASH=deepseek-v4-flash
MODEL_DEEPSEEK_PRO=deepseek-v4-pro
MODEL_QWEN_FLASH=qwen3.7-flash
MODEL_QWEN_PRO=qwen3.7-plus
MODEL_QWEN_MAX=qwen3.7-max

# SiliconFlow fallback IDs. Verify the exact IDs against the account's
# GET /v1/models response before production use, then override them here.
SILICONFLOW_MODEL_DEEPSEEK_FLASH=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_MODEL_DEEPSEEK_PRO=Pro/deepseek-ai/DeepSeek-V3.2
SILICONFLOW_MODEL_QWEN_FLASH=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_MODEL_QWEN_PRO=Qwen/Qwen3.5-122B-A10B
SILICONFLOW_MODEL_QWEN_MAX=Qwen/Qwen3.5-397B-A17B

# Proxy limits.
MODELMUX_REQUEST_TIMEOUT_MS=300000
MODELMUX_MAX_BODY_BYTES=2097152
MODELMUX_CORS_ORIGINS=

# Optional: replace all five default products with an ordered route map.
# Every apiKeyEnv value names another environment variable containing keys.
# adapter may be openai, deepseek, dashscope or siliconflow.
# MODELMUX_ROUTES_JSON={"deepseek-pro":[{"provider":"deepseek","baseUrl":"https://api.deepseek.com","upstreamModel":"deepseek-v4-pro","apiKeyEnv":"DEEPSEEK_API_KEYS","priority":100,"adapter":"deepseek"}]}
