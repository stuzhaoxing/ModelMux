# public: pre-event Internet service; local: competition Mac mini
MODELMUX_DEPLOYMENT_MODE=local
# 临时允许已登录的大屏访问 /screen?mock=1；公网演示时才设为 true
MODELMUX_ENABLE_SCREEN_MOCK=false
MODELMUX_PUBLIC_BASE_URL=http://localhost:1444
# Ingress addresses shown in the administrator overview.
MODELMUX_INTERNAL_BASE_URL=http://10.20.0.1:4000
# Leave blank when the service has no public inbound endpoint.
MODELMUX_EXTERNAL_BASE_URL=

# Client access. Every model API request must use a Bearer key.
# Example after generating keys: MODELMUX_CLIENT_KEYS=client-key-1,client-key-2
MODELMUX_CLIENT_KEYS=
MODELMUX_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
MODELMUX_ADMIN_SESSION_SECRET=
# Enable only when a trusted reverse proxy overwrites forwarded client headers.
MODELMUX_TRUST_PROXY=false

# Competition question-and-answer system. MySQL stores users, questions,
# answers and timestamps; uploaded images and other attachments remain on this server.
MODELMUX_DATABASE_URL=mysql://modelmux:change-me@127.0.0.1:3306/modelmux
MODELMUX_DATA_DIR=.modelmux-data
# Optional CJK TTF/OTF used by judge PDF exports. Leave blank to auto-detect.
MODELMUX_EXPORT_FONT_PATH=
MODELMUX_EXPORT_FONT_FAMILY=
# 实时通道（SSE）每个在线客户端的数据库轮询间隔，毫秒。调大省数据库、事件更慢。
# 取值被限制在 500-15000 之间，留空使用默认 3000。
MODELMUX_EVENT_POLL_MS=3000
# 考务工作台默认比赛时长。管理员开始比赛时可修改，必须为正整数。
MODELMUX_COMPETITION_DURATION_MINUTES=90

# Upstream providers. Each variable accepts a comma-separated key pool.
# DeepSeek official serves deepseek-*; Alibaba Cloud serves qwen-*;
# SiliconFlow supplies the fallback route for both model families.
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEYS=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
SILICONFLOW_API_KEYS=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
# Doubao models are advertised only after an Ark key is configured.
ARK_API_KEYS=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api

# Official primary-platform model IDs. These exact values are also the public
# model IDs accepted by the gateway; shorthand names are not supported.
MODEL_DEEPSEEK_FLASH=deepseek-v4-flash
MODEL_DEEPSEEK_PRO=deepseek-v4-pro
MODEL_QWEN_FLASH=qwen3.7-flash
MODEL_QWEN_PLUS=qwen3.7-plus
MODEL_QWEN_MAX=qwen3.7-max
MODEL_QWEN_3_8_MAX=qwen3.8-max
MODEL_GLM_5_3=ZHIPU/GLM-5.3
MODEL_KIMI_K3=kimi/kimi-k3
MODEL_MINIMAX_M3=MiniMax/MiniMax-M3
MODEL_DOUBAO_SEED_2_0_PRO=doubao-seed-2-0-pro-260215

# SiliconFlow fallback IDs. Verify the exact IDs against the account's
# GET /v1/models response before production use, then override them here.
SILICONFLOW_MODEL_DEEPSEEK_FLASH=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_MODEL_DEEPSEEK_PRO=Pro/deepseek-ai/DeepSeek-V3.2
SILICONFLOW_MODEL_QWEN_FLASH=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_MODEL_QWEN_PLUS=Qwen/Qwen3.5-122B-A10B
SILICONFLOW_MODEL_QWEN_MAX=Qwen/Qwen3.5-397B-A17B

# Upstream request behavior.
MODELMUX_REQUEST_TIMEOUT_MS=300000
MODELMUX_CORS_ORIGINS=

# Optional inline-file offload for /v1/chat/completions. When both credentials
# are set, data:*;base64 values in image/file/video URL fields are decoded to a
# temporary file, uploaded with one OSS PutObject, and replaced by this public URL.
MODELMUX_OSS_ACCESS_KEY_ID=
MODELMUX_OSS_ACCESS_KEY_SECRET=
MODELMUX_OSS_REGION=oss-cn-beijing
MODELMUX_OSS_BUCKET=modelmux
MODELMUX_OSS_PUBLIC_BASE_URL=https://modelmux.oss-cn-beijing.aliyuncs.com
MODELMUX_OSS_INPUT_PREFIX=ai-inputs

# Optional: replace the generated default catalog with an ordered route map.
# Each object key must exactly match its highest-priority upstreamModel.
# Every apiKeyEnv value names another environment variable containing keys.
# adapter may be openai, deepseek, dashscope or siliconflow.
# chatCompletionsPath is optional and defaults to /v1/chat/completions.
# MODELMUX_ROUTES_JSON={"deepseek-v4-pro":[{"provider":"deepseek","baseUrl":"https://api.deepseek.com","upstreamModel":"deepseek-v4-pro","apiKeyEnv":"DEEPSEEK_API_KEYS","priority":100,"adapter":"deepseek"}]}
